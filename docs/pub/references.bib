@article{young_andsoroka12,
  title = {Affective {{News}}: {{The Automated Coding}} of {{Sentiment}} in {{Political Texts}}},
  shorttitle = {Affective {{News}}},
  author = {Young, Lori and {and Soroka}, Stuart},
